# .gitignore

# ----------------------------------------------------------------------
# Terraform directories and files
# ----------------------------------------------------------------------
# Local .terraform directories (プラグインなどの巨大なファイル)
**/.terraform/*

# .tfstate files (リソースの状態が書かれたファイル。パスワードなどが含まれるため絶対コミットしない)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# (変数定義ファイル。今回は使っていませんが念の為)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ----------------------------------------------------------------------
# OS generated files
# ----------------------------------------------------------------------
.DS_Store